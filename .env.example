# Copy this file to .env and fill in local-only values.
# Do not commit .env.

DB_URL=jdbc:postgresql://localhost:5432/aischeduler
DB_USERNAME=postgres
DB_PASSWORD=12345

SERVER_PORT=8081

LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-new-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8081/api/auth/oauth/google/callback

# ---------------------------------------------------------------------------
# Self-host via docker-compose (see SELF-HOST.md). These are only read by
# docker-compose; run-local.ps1 ignores them. compose overrides DB_URL/
# FRONTEND_ORIGIN/GOOGLE_REDIRECT_URI internally, so you don't touch those here.
# ---------------------------------------------------------------------------
POSTGRES_DB=aischeduler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-something-strong

# Public HTTPS URL your Cloudflare tunnel exposes (NO trailing slash).
# Quick tunnel: the https://xxxx.trycloudflare.com URL it prints.
# Named tunnel: your own domain, e.g. https://study.example.com
PUBLIC_URL=https://REPLACE-WITH-YOUR-TUNNEL-URL
